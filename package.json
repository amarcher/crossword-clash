{
  "name": "crossword-clash",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:bookmarklet && pnpm build:daily-index && vite",
    "build": "pnpm build:bookmarklet && pnpm build:daily-index && tsc -b && vite build",
    "build:bookmarklet": "node scripts/build-bookmarklet.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "playwright test",
    "build:daily-index": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/build-daily-index.mts",
    "daily:add": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/add-daily-puzzle.mts",
    "seedgrid": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/make.mts",
    "seedgrid:dict": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/build-dict.mts",
    "seedgrid:studio-dict": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/studio-dict.mts",
    "apple:client-secret": "node --experimental-strip-types scripts/apple-client-secret.mts",
    "seedgrid:upload-dict": "for f in words-production.dict NOTICES.txt; do npx supabase storage rm ss:///seedgrid/$f --experimental --linked --yes >/dev/null 2>&1; npx supabase storage cp public/seedgrid/$f ss:///seedgrid/$f --experimental --linked --content-type 'text/plain; charset=utf-8' --cache-control max-age=300 || exit 1; done",
    "build:engine": "engine/build.sh",
    "seedgrid:large": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/large.mts",
    "seedgrid:lively": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/lively.mts",
    "seedgrid:timely": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/timely.mts",
    "seedgrid:reclue": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/reclue.mts",
    "seedgrid:refix": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/refix.mts",
    "seedgrid:crosscheck": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/seedgrid/crosscheck.mts",
    "build:native-import": "node scripts/build-native-import.mjs",
    "mobile:sync": "pnpm build:native-import && pnpm build --mode mobile && cap sync",
    "mobile:ios": "cap open ios",
    "testflight": "scripts/testflight.sh",
    "mobile:android": "cap open android",
    "indexnow": "node scripts/indexnow.mjs",
    "stripe:setup": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/stripe-setup.mts",
    "stripe:portal-config": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/stripe-portal-config.mts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-app-update": "8.1.1",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@elevenlabs/client": "^1.10.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.6",
    "@sentry/react": "^11.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.10.3",
    "@vercel/og": "1.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "@xwordly/xword-parser": "~1.0.5",
    "i18next": "^25.8.13",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.49.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-qr-code": "^2.0.18",
    "react-router": "^7.18.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "fflate@<0.7.5": "0.7.5"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "yaml": "^2.9.1"
  }
}
