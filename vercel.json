{
  "rewrites": [
    { "source": "/share", "destination": "/api/share" },
    { "source": "/daily-puzzles/midi/:day.json", "destination": "/api/daily?day=:day&slot=midi" },
    { "source": "/daily-puzzles/large/:day.json", "destination": "/api/daily?day=:day&slot=large" },
    { "source": "/daily-puzzles/:day.json", "destination": "/api/daily?day=:day" },
    { "source": "/((?!api/)(?!assets/)(?!daily-puzzles/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/daily-puzzles/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
