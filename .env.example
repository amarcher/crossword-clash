VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Monetization (optional — app works without these)
VITE_ADSENSE_PUB_ID=
VITE_AD_SLOT_MENU=
VITE_AD_SLOT_COMPLETION=
VITE_AD_SLOT_IMPORT=
VITE_AD_SLOT_PUZZLE_READY=
VITE_NYT_AFFILIATE_URL=

# AI narrator cost ceiling (Supabase Edge Function secret, NOT a VITE_ client var).
# Set via `supabase secrets set NARRATOR_MONTHLY_USD_CAP=20`. Once estimated
# month-to-date Anthropic + ElevenLabs + OpenAI spend (read from the Neon
# api_usage ledger) reaches this many USD, the narrator/TTS edge functions stop
# authorizing new sessions and return { error: "narrator_unavailable",
# reason: "budget" }. Defaults to 20 when unset.
# NARRATOR_MONTHLY_USD_CAP=20

# Error reporting (optional). When set, @sentry/react is lazy-loaded and
# unexpected errors are reported. Unset = no-op. Always OFF in the native
# (--mode mobile) build. Setting a DSN makes the error-reporting paragraph of
# the privacy policy (/privacy) apply.
VITE_SENTRY_DSN=

# Crossword Clash Plus (docs/plus-setup.md). The launch switch: with it unset
# nothing Plus-related is fetched or shown and every gate keeps its pre-Plus
# behaviour. Set to 1 in the Vercel production env and the mobile build on
# launch day.
# VITE_PLUS=1
#
# Supabase secrets (NOT client vars) read by verify-purchase / delete-account:
# REVENUECAT_WEBHOOK_SECRET, REVENUECAT_SECRET_KEY, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, optional REVENUECAT_ALLOW_SANDBOX=1 (staging only).
